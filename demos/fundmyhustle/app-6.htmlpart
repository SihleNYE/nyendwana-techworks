photoIndex=0;$('photoInput').value='';$('photoFeedback').textContent='';drawPhotoEditor();screen('photoEditor')}
function compressPhoto(file){return new Promise((resolve,reject)=>{if(!['image/jpeg','image/png','image/webp'].includes(file.type)&&!(file.type===''&&/\.(jpe?g|png|webp)$/i.test(file.name))){reject(new Error('Choose a JPEG, PNG or WebP image.'));return}if(file.size>10*1024*1024){reject(new Error('Each photo must be 10 MB or smaller.'));return}const reader=new FileReader();reader.onerror=()=>reject(new Error('Could not read that photo. Try another.'));reader.onload=()=>{const image=new Image();image.onerror=()=>reject(new Error('That photo could not be opened. Try JPEG, PNG or WebP.'));image.onload=()=>{try{const width=image.naturalWidth,height=image.naturalHeight;if(!width||!height||width*height>40000000)throw new Error('Choose an image smaller than 40 megapixels.');const scale=Math.min(1,960/Math.max(width,height));const canvas=document.createElement('canvas');canvas.width=Math.max(1,Math.round(width*scale));canvas.height=Math.max(1,Math.round(height*scale));const ctx=canvas.getContext('2d');if(!ctx)throw new Error('Photo preview is unavailable here.');ctx.fillStyle='#FFF8EE';ctx.fillRect(0,0,canvas.width,canvas.height);ctx.drawImage(image,0,0,canvas.width,canvas.height);const src=canvas.toDataURL('image/jpeg',0.78);if(!src.startsWith('data:image/jpeg'))throw new Error('Photo conversion failed. Try another photo.');resolve({src,caption:''})}catch(error){reject(error)}};image.src=reader.result};reader.readAsDataURL(file)})}
$('photoInput').onchange=async()=>{if(photoBusy)return;const files=Array.from($('photoInput').files||[]);if(!files.length)return;const session=photoSession;photoBusy=true;drawPhotoEditor();$('photoFeedback').textContent='Preparing photo previews…';let added=0,errors=[];for(const file of files){if(session!==photoSession)return;if(photoWorking.length>=3){errors.push('3-photo limit reached.');break}try{const photo=await compressPhoto(file);if(session!==photoSession)return;photoWorking.push(photo);photoIndex=photoWorking.length-1;added++}catch(error){errors.push(error.message)}}if(session!==photoSession)return;photoBusy=false;$('photoInput').value='';drawPhotoEditor();$('photoFeedback').textContent=(added?added+' photo'+(added===1?'':'s')+' added. ':'')+errors.join(' ')};
$('photoCaption').oninput=()=>{if(photoWorking[photoIndex])photoWorking[photoIndex].caption=$('photoCaption').value.slice(0,80)};
$('photoNext').onclick=()=>{if(!photoBusy&&photoWorking.length){photoIndex=(photoIndex+1)%photoWorking.length;drawPhotoEditor()}};
$('photoRemove').onclick=()=>{if(photoBusy||!photoWorking.length)return;photoWorking.splice(photoIndex,1);photoIndex=Math.max(0,Math.min(photoIndex,photoWorking.length-1));drawPhotoEditor();$('photoFeedback').textContent='Photo removed from this edit. Save to keep the change.'};
$('photoCover').onclick=()=>{if(photoBusy||!photoWorking.length)return;const selected=photoWorking.splice(photoIndex,1)[0];photoWorking.unshift(selected);photoIndex=0;drawPhotoEditor();$('photoFeedback').textContent='Cover photo selected.'};
$('photoCancel').onclick=()=>{photoSession++;photoBusy=false;screen(photoTarget==='draft'?'create':'details')};
$('photoSave').onclick=()=>{if(photoBusy)return;if(photoTarget==='draft'){draftPhotos=clonePhotos(photoWorking);$('addDraftPhotos').textContent=draftPhotos.length?'Edit photos · '+draftPhotos.length+' / 3':'Add campaign photos (optional)';screen('create')}else{campaigns[photoCampaign].photos=clonePhotos(photoWorking);current=photoCampaign;galleryIndex=0;render();screen('details')}};
$('addDraftPhotos').onclick=()=>openPhotos('draft');$('editCampaignPhotos').onclick=()=>{if(campaigns[current].own)openPhotos('campaign')};$('galleryNext').onclick=()=>{const photos=campaigns[current].photos||[];if(photos.length){galleryIndex=(galleryIndex+1)%photos.length;renderCampaignPhotos()}};
const detailsBeforePhotos=renderDetails;renderDetails=function(){detailsBeforePhotos();renderCampaignPhotos()};
const previewBeforePhotos=$('preview').onclick;$('preview').onclick=()=>{const count=campaigns.length;previewBeforePhotos();if(campaigns.length>count){campaigns[current].photos=clonePhotos(draftPhotos);draftPhotos=[];$('addDraftPhotos').textContent='Add campaign photos (optional)';galleryIndex=0;render()}};
let dashboardSelected=-1,activeScreen='explore',dashboardEditor=null,detailsOrigin='explore',createOrigin='explore';
function ownCampaigns(){return campaigns.map((campaign,index)=>({campaign,index})).filter(item=>item.campaign.own)}
function renderDashboard(){const owned=ownCampaigns(),total=owned.reduce((s,x)=>s+x.campaign.raised,0),goal=owned.reduce((s,x)=>s+x.campaign.goal,0),count=owned.reduce((s,x)=>s+(x.campaign.sessionDonations||[]).length,0),percent=goal?total/goal*100:0;$('dashboardRaised').textContent=money(total);$('dashboardGoal').textContent=money(goal);$('dashboardCount').textContent=String(owned.length);$('dashboardDonations').textContent=String(count);$('dashboardPercent').textContent=Math.round(percent)+'%';$('dashboardRing').setAttribute('stroke-dashoffset',String(245.05*(1-Math.min(100,percent)/100)));$('dashboardEmpty').hidden=owned.length>0;$('dashboardTools').hidden=!owned.length;if(!owned.length){dashboardSelected=-1;return}if(!owned.some(x=>x.index===dashboardSelected))dashboardSelected=owned[0].index;const chooser=$('dashboardCampaign');chooser.replaceChildren();owned.forEach(({campaign,index})=>{const option=document.createElement('option');option.value=String(index);option.textContent=campaign.title;chooser.append(option)});chooser.value=String(dashboardSelected);const c=campaigns[dashboardSelected],donations=c.sessionDonations||[];$('dashboardStatus').textContent=money(c.raised)+' of '+money(c.goal)+' · '+(c.raised>=c.goal?'Demo goal reached':money(c.goal-c.raised)+' to go');$('dashboardSetup').textContent='Budget: '+(c.budget&&c.budget.length?'added':'not added')+' · Photos: '+(c.photos||[]).length+'/3 · Organiser: '+(c.organiser?'added, not verified':'not added');const activity=$('dashboardActivity');activity.replaceChildren();const label=document.createElement('strong');label.textContent='Latest demo donations';activity.append(label);if(!donations.length)activity.append(paragraph('No donations yet for this campaign.'));else donations.slice(-3).reverse().forEach((amount,index)=>activity.append(paragraph((index===0?'Latest · ':'Earlier · ')+money(amount))));activity.append(paragraph('No real money collected.'));}
const screenBeforeDashboard=screen;screen=function(id){const from=activeScreen;if(dashboardEditor&&((id==='details'&&['budgetEditor','photoEditor','campaignEditor'].includes(from))||(id==='organiserProfile'&&from==='organiserEditor'))){id='dashboard';dashboardEditor=null}if(id==='dashboard')renderDashboard();activeScreen=id;screenBeforeDashboard(id)};
function openDashboard(){dashboardEditor=null;if(campaigns[current].own)dashboardSelected=current;screen('dashboard')}
$('openDashboard').onclick=openDashboard;$('dashboardBrowse').onclick=()=>{dashboardEditor=null;screen('explore')};$('dashboardCampaign').onchange=()=>{dashboardSelected=Number($('dashboardCampaign').value);renderDashboard()};$('dashboardAction').onchange=()=>{const labels={details:'View campaign',story:'Edit campaign story',budget:'Edit budget',photos:'Edit photos',profile:'Edit organiser profile'};$('dashboardManage').textContent=labels[$('dashboardAction').value]||'View campaign'};
$('dashboardNew').onclick=()=>{dashboardEditor=null;createOrigin='dashboard';screen('create')};const startBeforeDashboard=$('start').onclick;$('start').onclick=()=>{createOrigin='explore';startBeforeDashboard()};$('createBack').onclick=()=>screen(createOrigin);
$('dashboardManage').onclick=()=>{const c=campaigns[dashboardSelected];if(!c||!c.own)return;current=dashboardSelected;selectFilter('All');render();const action=$('dashboardAction').value;if(action==='details'){detailsOrigin='dashboard';detailTab='Story';renderDetails();screen('details');return}dashboardEditor=action;if(action==='budget')openBudget('campaign');else if(action==='photos')openPhotos('campaign');else if(action==='profile')openOrganiser('campaign');else if(action==='story'){$('campaignEditorTitle').value=c.title;$('campaignEditorStory').value=c.story;$('campaignEditorCategory').value=c.category;$('campaignEditorGoal').textContent=money(c.goal);$('campaignEditorFeedback').textContent='';screen('campaignEditor')}};
$('campaignEditorSave').onclick=()=>{if(!campaigns[current].own)return;const title=$('campaignEditorTitle').value.trim(),story=$('campaignEditorStory').value.trim(),category=$('campaignEditorCategory').value;if(!title||title.length>65||!story||story.length>350||!['Food','Services'].includes(category)){$('campaignEditorFeedback').textContent='Add a name (up to 65 characters), a story (up to 350) and a category.';return}Object.assign(campaigns[current],{title,story,category});render();screen('details')};$('campaignEditorCancel').onclick=()=>screen('details');
const detailsBeforeDashboard=$('viewDetails').onclick;$('viewDetails').onclick=()=>{detailsOrigin='explore';detailsBeforeDashboard()};$('detailsBack').onclick=()=>screen(detailsOrigin);
const previewBeforeDashboard=$('preview').onclick;$('preview').onclick=()=>{const count=campaigns.length;previewBeforeDashboard();if(campaigns.length>count){dashboardSelected=current;detailsOrigin='dashboard';dashboardEditor=null;screen('dashboard')}};
const giving=[];let donorSelected=-1,donorPage=0;
function renderDonor(){const ids=[...new Set(giving.map(d=>d.c))];$('donorTotal').textContent=money(giving.reduce((s,d)=>s+d.n,0));$('donorCampaigns').textContent=String(ids.length);$('donorEmpty').hidden=!!ids.length;$('donorTools').hidden=!ids.length;if(!ids.length)return;if(!ids.includes(donorSelected))donorSelected=ids[0];const chooser=$('donorCampaign');chooser.replaceChildren();ids.forEach(i=>{const option=document.createElement('option');option.value=Stri