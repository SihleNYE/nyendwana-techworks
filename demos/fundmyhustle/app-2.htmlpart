der-radius:0;background:#F3F0E8}a{color:inherit}button:disabled{opacity:.55;cursor:not-allowed}button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:3px solid #CFA14A;outline-offset:3px}.badge{display:inline-block;border-radius:8px;padding:4px 8px}.demo-shell{max-width:460px;margin:25px auto;padding:20px;background:#FFF8EE;border:1px solid #D9DECD;border-radius:22px;box-shadow:0 10px 40px #102B5C14}.demo-shell input:not([type=range]),.demo-shell textarea,.demo-shell select{padding:10px;border:1px solid #B8C6B7;border-radius:10px;background:#FFFDF8;color:#12382D}.demo-shell input[type=range]{accent-color:#12382D}.demo-shell .ghost{background:transparent;border-color:transparent;color:#12382D;box-shadow:none}.demo-shell .secondary{background:transparent;color:#12382D}.caption{line-height:1.5}.portfolio-header{display:flex;justify-content:space-between;align-items:center;gap:16px;background:#102B5C;color:#F3F0E8;padding:18px max(18px,calc((100vw - 1000px)/2));font-size:12px}.portfolio-header strong{display:block;color:#CFA14A;font-size:13px}.portfolio-header a{text-underline-offset:4px}.demo-notice{max-width:460px;margin:22px auto 0;padding:0 18px;font-size:12px;line-height:1.5;color:#102B5C}.demo-notice h1{font-size:25px;letter-spacing:-.04em;margin:0 0 7px}.portfolio-footer{padding:0 20px 28px;text-align:center;font-size:12px;color:#102B5C}@media(max-width:500px){.demo-shell{margin:18px 12px;padding:16px}.portfolio-header{padding:15px 16px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}</style></head><body><header class="portfolio-header"><div><strong>NYENDWANA TECHWORKS</strong>Interactive portfolio demo</div><a href="../">All demos →</a></header><div class="demo-notice"><h1>FundmyHustle</h1><strong>A crowdfunding web-app concept, not a live fundraising service.</strong><br>Fictional sample campaigns. Simulated donations. No payments or payouts. Changes clear on reload.</div><main class="demo-shell" aria-label="FundmyHustle interactive demo">
<section class="screen active" id="explore">
<div class="brand"><div class="identity"><svg class="brandmark" viewBox="0 0 40 40" role="img" aria-label="FMH rising bars supported from below"><g fill="#12382D"><rect x="5" y="16" width="7" height="12" rx="3"/><rect x="16" y="10" width="7" height="18" rx="3"/><rect x="27" y="4" width="7" height="24" rx="3"/></g><path d="M5 31Q20 40 35 31" fill="none" stroke="#12382D" stroke-width="4" stroke-linecap="round"/></svg><div><h2 class="wordmark">FMH<span style="color:#A3481B">.</span></h2><span class="brandname">FundmyHustle</span></div></div><span class="badge">Donations only</span></div>
<div class="topline"><p class="subtitle">Back a hustle. Build a future.</p><div id="givingNav"><button class="ghost" id="openDonor">My giving</button><button class="ghost" id="openDashboard">Creator</button></div></div>
<div class="segmented" aria-label="Filter campaigns"><button class="selected" data-filter="All" aria-pressed="true">All</button><button data-filter="Food" aria-pressed="false">Food</button><button data-filter="Services" aria-pressed="false">Services</button></div>
<div class="stage"><div class="topline"><span class="badge" id="category">Food</span><small id="count">1 of 3</small></div>
<img id="campaignCover" class="campaign-photo" alt="Campaign cover" hidden><svg id="campaignIllustration" viewBox="0 0 300 120" role="img" aria-label="Small business with a growing funding chart"><g class="grow" fill="none" stroke="var(--toqi-text-secondary)" stroke-width="2.5" stroke-linejoin="round"><path d="M20 110H280" stroke="var(--toqi-border)"/><rect x="43" y="56" width="112" height="54" rx="4" fill="var(--toqi-surface)"/><path d="M34 56L50 29H150L166 56Z" fill="var(--toqi-accent-soft)" stroke="var(--toqi-accent)"/><path d="M62 30L56 55M88 30L86 55M113 30L116 55M138 30L146 55" stroke="var(--toqi-accent)"/><rect x="59" y="70" width="34" height="25" rx="3"/><path d="M112 110V72H140V110"/><path d="M184 102V87H199V102M213 102V67H228V102M242 102V45H257V102" stroke="var(--toqi-accent)" fill="var(--toqi-accent-soft)"/><path d="M184 63L216 42L250 22M237 22H250V35" stroke="var(--toqi-accent)"/></g></svg>
<h3 id="campaignTitle">A bigger pot, a bigger hustle</h3><small id="owner">Example campaign</small>
<p class="description" id="story">Help a home cook buy a gas stove and pots to serve more lunchtime customers.</p><button class="ghost" id="viewDetails">View campaign details →</button>
<div class="meter" id="meter" role="progressbar" aria-label="Funding progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="35"><span id="fill" style="width:35%"></span></div></div>
<div class="stats"><div class="stat"><strong class="accent" id="raised">R1,750</strong><small>demo donations</small></div><div class="stat"><strong id="goal">R5,000</strong><small>goal</small></div></div>
<div class="toolbar"><button class="secondary" id="next">Next hustle</button><button id="donate">Try demo donation</button></div><button class="ghost" id="start">Start my hustle</button>
<p class="caption">Demo only. No real payments. Campaigns stay in this session. Donations offer no rewards, equity or financial returns. Changes last for this session.</p>
</section>
<section class="screen" id="details">
<div class="topline"><h2>Campaign details</h2><button class="ghost" id="detailsBack" data-back>Back</button></div>
<div class="stage"><span class="detail-pill" id="detailsCategory">Food · Sample campaign</span><h3 id="detailsTitle">A bigger pot, a bigger hustle</h3><p class="details-note" id="detailsOrganizer">Organiser: example home cook · Not verified</p><button class="ghost" id="viewOrganiser">View organiser profile</button>
<div id="detailsGallery" hidden><img id="detailsPhoto" class="campaign-photo" alt="Campaign photo"><span id="galleryCaption"></span><div class="topline"><small id="galleryCount">Photo 1 of 1</small><button class="ghost" id="galleryNext">Next photo</button></div></div><button class="ghost" id="editCampaignPhotos" hidden>Add campaign photos</button><svg viewBox="0 0 300 65" role="img" aria-label="Funding progress toward the campaign goal"><path d="M20 48H280" stroke="#D9DECD" stroke-width="8" stroke-linecap="round"/><path id="fundingLine" d="M20 48H111" stroke="#12382D" stroke-width="8" stroke-linecap="round"/><circle id="fundingDot" cx="111" cy="48" r="10" fill="#C7F35C" stroke="#12382D" stroke-width="2"/><text id="detailsPercent" x="20" y="22" font-size="13" fill="#12382D">35% funded</text></svg>
<div class="stats"><div class="stat"><strong id="detailsRaised">R1,750</strong><small>demo donations</small></div><div class="stat"><strong id="detailsGoal">R5,000</strong><small>goal</small></div></div><small id="detailsRemaining">R3,250 still needed</small></div>
<div class="segmented" aria-label="Campaign information"><button class="selected" data-detail-tab="Story" aria-pressed="true">Story</button><button data-detail-tab="Budget" aria-pressed="false">Budget</button><button data-detail-tab="Updates" aria-pressed="false">Updates</button></div>
<div id="detailContent" aria-live="polite"></div><button class="secondary" id="editBudget" hidden>Edit my budget</button><button id="detailsDonate">Try demo donation</button><p class="caption">Demo only. No charges or payouts. Donations offer no rewards, equity or financial returns.</p>
</section>
<section class="screen" id="donation"><div class="topline"><h2>Support this hustle</h2><button class="ghost" data-back>Back</button></div><p class="subtitle" id="donationTitle">A bigger pot, a bigger hustle</p>
<div class="stage"><svg viewBox="0 0 300 120" role="img" aria-label="A heart representing a donation"><circle cx="150" cy="60" r="47" fill="var(--toqi-accent-soft)"/><path d="M150 88L120 60C101 38 132 22 150 43C168 22 199 38 180 60Z" fill="var(--toqi-accent)"/></svg></div>
<div class="big accent" id="amountDisplay">R100</div><label for="amount">Demo donation amount</label><input type="range" id="amount" min="25" max="1000" step="25" value="100">
<p class="description">A donation supports the campaign, without buying a product, reward, ownership or financial return.</p><p class="caption">This is a simulation. No money will be charged.</p><button id="confirm">Add demo donation</button><p class="feedback" id="donationFeedback" role="status"></p><button class="ghost" id="donationGiving">View my giving</button></section>
<section class="screen" id="create"><div class="topline"><h2>Start my hustle</h2><button class="ghost" id="createBack" data-back>Back</button></div><p class="subtitle">Ask for support. Show what it will fund.</p>
<label for="newTitle">Campaign name</label><input id="newTitle" maxlength="65" placeholder="Help me open my barber corner">
<label for="newCategory">Category</label><select id="newCategory"><option>Food</option><option>Services</option></select>
<label for="newGoal">Donation goal (rand)</label><input id="newGoal" type="number" min="100" max="1000000" step="1" value="5000" inputmode="numeric">
<label for="newStory">How will you use the donations?</label><textarea id="newStory" maxlength="350" placeholder="Explain your hustle, what you need and how the money will help."></textarea>
<button class="ghost" id="addDraftPhotos">Add campaign photos (optional)</button><button class="ghost" id="addDraftOrganiser">Add organiser profile (optional)</button><button class="ghost" id="addDraftBudget">Add itemised budget (optional)</button><p class="caption">Donations only. Do not promise rewards, ownership or financial returns. Campaigns are not published in this demo.</p><button id="preview">Create demo campaign</button><p class="feedback" id="createFeedback" role="status"></p></section>
<section class="screen" id="budgetEditor">
<div class="topline"><h2>Budget editor</h2><button class="ghost" id="cancelBudget">Cancel</button></div><p class="subtitle">Give every rand a purpose. Up to 10 items.</p>
<div class="stage"><svg