ng(i);option.textContent=campaigns[i].title;chooser.append(option)});chooser.value=String(donorSelected);const c=campaigns[donorSelected],entries=giving.filter(d=>d.c===donorSelected).slice().reverse(),sum=entries.reduce((s,d)=>s+d.n,0),percent=sum/c.goal*100;$('donorContribution').textContent=money(sum);$('donorGoal').textContent='of a '+money(c.goal)+' goal';$('donorPercent').textContent=Math.round(percent)+'%';$('donorRing').setAttribute('stroke-dashoffset',String(207.35*(1-Math.min(100,percent)/100)));$('donorNote').textContent=(c.own?'Your demo campaign':'Fictional sample campaign')+' · Organiser not verified';const pages=Math.ceil(entries.length/3);donorPage=Math.min(donorPage,pages-1);const history=$('donorHistory');history.replaceChildren();entries.slice(donorPage*3,donorPage*3+3).forEach(d=>{const row=document.createElement('p'),value=document.createElement('strong'),ref=document.createElement('small');value.textContent=money(d.n)+' · Demo contribution';ref.textContent='FMH-DEMO-'+String(d.id).padStart(4,'0')+' · Not a payment receipt';row.append(value,ref);history.append(row)});$('donorPager').textContent=entries.length+' donation'+(entries.length===1?'':'s')+' · Page '+(donorPage+1)+' / '+pages;$('donorNext').hidden=pages<2}
const screenBeforeDonor=screen;screen=function(id){if(id==='donorView')renderDonor();screenBeforeDonor(id)};
const confirmBeforeGiving=$('confirm').onclick;$('confirm').onclick=()=>{if($('confirm').disabled)return;const n=Number($('amount').value);if(!Number.isInteger(n)||n<25||n>1000||n%25){$('donationFeedback').textContent='Choose R25 to R1,000 in R25 steps.';return}const c=current,before=campaigns[c].raised;confirmBeforeGiving();if(campaigns[c].raised===before+n){giving.push({id:giving.length+1,c,n});donorSelected=c;donorPage=0}};
function openGiving(){donorPage=0;screen('donorView')}$('openDonor').onclick=openGiving;$('donationGiving').onclick=openGiving;$('donorBrowse').onclick=()=>screen('explore');$('donorDiscover').onclick=()=>screen('explore');$('donorCampaign').onchange=()=>{donorSelected=Number($('donorCampaign').value);donorPage=0;renderDonor()};$('donorNext').onclick=()=>{const pages=Math.ceil(giving.filter(d=>d.c===donorSelected).length/3);donorPage=(donorPage+1)%pages;renderDonor()};
function donorCurrent(){current=donorSelected;selectFilter('All');render()}
$('donorDetails').onclick=()=>{donorCurrent();detailsOrigin='donorView';detailTab='Story';renderDetails();screen('details')};$('donorAgain').onclick=()=>{donorCurrent();openDonation('donorView')};
render();
</script></body></html>